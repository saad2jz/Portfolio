      {
        "id": "education-kedge",
        "html": "<div class=\"project-body creator-project-intro\"><div class=\"project-copy\"><p data-i18n=\"journeykedgeType\" class=\"micro\">BUSINESS / DUAL QUALIFICATION</p><h3 id=\"education-kedge-title\">KEDGE Business School</h3><p data-i18n=\"education-kedgeDegree\" class=\"education-qualification\">Double degree: MSc Business Engineer &amp; Master Ingénieur d’Affaires</p><p data-i18n=\"education-kedgeIntro\" class=\"project-description\">Connecting technology, client needs and business value through B2B strategy, complex solution selling and project management.</p></div><div class=\"project-context\"><div class=\"project-logos education-logos\" role=\"group\" aria-label=\"Institutions / Établissements\"><a href=\"https://etudiant.kedge.edu/programmes/ingenieur-affaires\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"assets/logos/kedge.svg\" alt=\"KEDGE Business School\" class=\"school-logo school-kedge\" width=\"140\" height=\"40\" loading=\"lazy\" decoding=\"async\"/></a></div><p data-i18n=\"education-kedgeLocation\" class=\"journey-location\">Toulon · France</p><p class=\"journey-date\">2026</p></div></div><div class=\"journey-highlights\" aria-label=\"Focus / Domaines\"><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"m12 12 9-9M16 3h5v5\"/></svg></span><strong data-i18n=\"education-kedgeFocus0\">B2B strategy</strong></div><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m2 7 4-3 5 2 3-2 8 4-3 8-4 4-4-2-4-4-2-2-3-5M6 4l-4 8M18 6l-6 5-3-2 3-3M10 14l4 4M13 12l4 4\"/></svg></span><strong data-i18n=\"education-kedgeFocus1\">Complex sales</strong></div><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"5\" r=\"2\"/><circle cx=\"19\" cy=\"19\" r=\"2\"/><path d=\"M7 5h8a4 4 0 0 1 0 8H9a3 3 0 0 0 0 6h8\"/></svg></span><strong data-i18n=\"education-kedgeFocus2\">Project management</strong></div></div><details class=\"project-story education-story\" id=\"education-kedge-details\"><summary><span data-i18n=\"journeyCourseDetails\">Programme &amp; subjects</span><span class=\"summary-icon\" aria-hidden=\"true\">+</span></summary><div class=\"case-content\"><h4 data-i18n=\"educationCurriculumHeading\">Curriculum overview</h4><dl class=\"education-curriculum\"><div><dt data-i18n=\"education-kedgeModule0Title\">Strategy &amp; markets</dt><dd data-i18n=\"education-kedgeModule0Body\">Market research, B2B marketing, business plans and responsible international development.</dd></div><div><dt data-i18n=\"education-kedgeModule1Title\">Negotiation &amp; key accounts</dt><dd data-i18n=\"education-kedgeModule1Body\">Complex solution selling, tender responses and customer portfolio management.</dd></div><div><dt data-i18n=\"education-kedgeModule2Title\">Finance &amp; contracts</dt><dd data-i18n=\"education-kedgeModule2Body\">Financial indicators, international contract law, purchasing strategy and supply chain.</dd></div><div><dt data-i18n=\"education-kedgeModule3Title\">Projects &amp; digital business</dt><dd data-i18n=\"education-kedgeModule3Body\">Project tools, agile management, CRM, lead generation and data-driven commercial performance.</dd></div></dl><p data-i18n=\"education-kedgeNote\" class=\"education-reference-note\">Programme overview covering the common curriculum; specialisation modules depend on the chosen pathway.</p><div class=\"education-sources\"><a class=\"text-link\" href=\"https://etudiant.kedge.edu/programmes/ingenieur-affaires/parcours\" target=\"_blank\" rel=\"noopener noreferrer\"><span data-i18n=\"education-kedgeSource0\">KEDGE · programme &amp; curriculum</span><span aria-hidden=\"true\">↗</span></a></div></div></details>",
        "label": "KEDGE Business School"
      },
      {
        "id": "education-isen",
        "html": "<div class=\"project-body creator-project-intro\"><div class=\"project-copy\"><p data-i18n=\"journeyisenType\" class=\"micro\">DIGITAL / BUSINESS &amp; DATA ANALYST TRACK</p><h3 id=\"education-isen-title\">ISEN Méditerranée</h3><p data-i18n=\"education-isenDegree\" class=\"education-qualification\">Business &amp; Data Analyst track · KEDGE–ISEN partnership</p><p data-i18n=\"education-isenIntro\" class=\"project-description\">A digital track taught by the engineering school alongside KEDGE studies, connecting business analysis, data visualisation and cloud fundamentals.</p></div><div class=\"project-context\"><div class=\"project-logos education-logos\" role=\"group\" aria-label=\"Institutions / Établissements\"><a href=\"https://isen-mediterranee.fr/kedge-isen-double-diplome/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"assets/logos/isen.webp\" alt=\"ISEN Méditerranée\" class=\"school-logo school-isen\" width=\"140\" height=\"40\" loading=\"lazy\" decoding=\"async\"/></a></div><p data-i18n=\"education-isenLocation\" class=\"journey-location\">Toulon · France</p></div></div><div class=\"journey-highlights\" aria-label=\"Focus / Domaines\"><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 3v17h17M8 16v-4M13 16V7M18 16V4\"/></svg></span><strong data-i18n=\"education-isenFocus0\">Business analysis</strong></div><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><img src=\"assets/logos/powerbi.svg\" alt=\"\" width=\"26\" height=\"26\" loading=\"lazy\" decoding=\"async\"/></span><strong data-i18n=\"education-isenFocus1\">Power BI</strong></div><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><img src=\"assets/hero-tools/amazonaws.svg\" alt=\"\" width=\"26\" height=\"26\" loading=\"lazy\" decoding=\"async\"/></span><strong data-i18n=\"education-isenFocus2\">AWS Cloud</strong></div></div><details class=\"project-story education-story\" id=\"education-isen-details\"><summary><span data-i18n=\"journeyCourseDetails\">Programme &amp; subjects</span><span class=\"summary-icon\" aria-hidden=\"true\">+</span></summary><div class=\"case-content\"><h4 data-i18n=\"educationCurriculumHeading\">Curriculum overview</h4><dl class=\"education-curriculum\"><div><dt data-i18n=\"education-isenModule0Title\">Business &amp; data</dt><dd data-i18n=\"education-isenModule0Body\">Digital skills for business analysis and data-informed decision-making.</dd></div><div><dt data-i18n=\"education-isenModule1Title\">Business intelligence</dt><dd data-i18n=\"education-isenModule1Body\">Power BI preparation within the track: a focus on business data and reporting.</dd></div><div><dt data-i18n=\"education-isenModule2Title\">Cloud fundamentals</dt><dd data-i18n=\"education-isenModule2Body\">AWS Cloud certification preparation included in the published track description.</dd></div></dl><p data-i18n=\"education-isenNote\" class=\"education-reference-note\">The partnership describes a track leading to an ISEN certificate, distinct from the engineering degree. Certification preparation does not imply certification has been awarded.</p><div class=\"education-sources\"><a class=\"text-link\" href=\"https://isen-mediterranee.fr/kedge-isen-double-diplome/\" target=\"_blank\" rel=\"noopener noreferrer\"><span data-i18n=\"education-isenSource0\">ISEN · KEDGE partnership (2025)</span><span aria-hidden=\"true\">↗</span></a></div></div></details>",
        "label": "ISEN Méditerranée"
      },
      {
        "id": "education-franche-comte",
        "html": "<div class=\"project-body creator-project-intro\"><div class=\"project-copy\"><p data-i18n=\"journeyfranche-comteType\" class=\"micro\">QUALITY / MASTER’S</p><h3 id=\"education-franche-comte-title\">Université de Franche-Comté</h3><p data-i18n=\"education-franche-comteDegree\" class=\"education-qualification\">Master’s in Quality &amp; Performance Management</p><p data-i18n=\"education-franche-comteIntro\" class=\"project-description\">A bridge between statistical methods, quality systems and organisational performance, with a focus on continuous improvement.</p></div><div class=\"project-context\"><div class=\"project-logos education-logos\" role=\"group\" aria-label=\"Institutions / Établissements\"><a href=\"https://www.francecompetences.fr/wp-json/api/v1/right-files/export/10436\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"assets/logos/franche-comte.webp\" alt=\"Université de Franche-Comté\" class=\"school-logo school-franche-comte\" width=\"80\" height=\"40\" loading=\"lazy\" decoding=\"async\"/><span class=\"school-abbreviation\" aria-hidden=\"true\">uFC</span></a></div><p data-i18n=\"education-franche-comteLocation\" class=\"journey-location\">Besançon · France</p></div></div><div class=\"journey-highlights\" aria-label=\"Focus / Domaines\"><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z\"/><path d=\"m8 12 3 3 5-6\"/></svg></span><strong data-i18n=\"education-franche-comteFocus0\">Quality systems</strong></div><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 3v17h17M8 16v-4M13 16V7M18 16V4\"/></svg></span><strong data-i18n=\"education-franche-comteFocus1\">Statistics &amp; measurement</strong></div><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 7a8 8 0 0 0-14-2L3 8M3 3v5h5M4 17a8 8 0 0 0 14 2l3-3M21 21v-5h-5\"/></svg></span><strong data-i18n=\"education-franche-comteFocus2\">Continuous improvement</strong></div></div><details class=\"project-story education-story\" id=\"education-franche-comte-details\"><summary><span data-i18n=\"journeyCourseDetails\">Programme &amp; subjects</span><span class=\"summary-icon\" aria-hidden=\"true\">+</span></summary><div class=\"case-content\"><h4 data-i18n=\"educationCurriculumHeading\">Curriculum overview</h4><dl class=\"education-curriculum\"><div><dt data-i18n=\"education-franche-comteModule0Title\">Standards &amp; quality systems</dt><dd data-i18n=\"education-franche-comteModule0Body\">Standards, quality frameworks, certification processes and integrated management with risk control.</dd></div><div><dt data-i18n=\"education-franche-comteModule1Title\">Measurement &amp; statistics</dt><dd data-i18n=\"education-franche-comteModule1Body\">Quality measurement, statistical modelling and statistical techniques for quality management.</dd></div><div><dt data-i18n=\"education-franche-comteModule2Title\">Improvement &amp; operations</dt><dd data-i18n=\"education-franche-comteModule2Body\">Total Quality Management, quality tools and methods, production management and customer satisfaction.</dd></div><div><dt data-i18n=\"education-franche-comteModule3Title\">Projects &amp; people</dt><dd data-i18n=\"education-franche-comteModule3Body\">Project management, innovation, the human and social dimensions of quality, individual project and internship.</dd></div></dl><p data-i18n=\"education-franche-comteNote\" class=\"education-reference-note\">Curriculum summarised from the historical QMP qualification framework (RNCP 17136).</p><div class=\"education-sources\"><a class=\"text-link\" href=\"https://www.francecompetences.fr/wp-json/api/v1/right-files/export/10436\" target=\"_blank\" rel=\"noopener noreferrer\"><span data-i18n=\"education-franche-comteSource0\">France Compétences · QMP curriculum</span><span aria-hidden=\"true\">↗</span></a></div></div></details>",
        "label": "Université de Franche-Comté"
      },
      {
        "id": "education-uir-nantes",
        "html": "<div class=\"project-body creator-project-intro\"><div class=\"project-copy\"><p data-i18n=\"journeyuir-nantesType\" class=\"micro\">COMPUTER SCIENCE / DUAL DEGREE</p><h3 id=\"education-uir-nantes-title\">UIR × Université de Nantes</h3><p data-i18n=\"education-uir-nantesDegree\" class=\"education-qualification\">Bachelor’s in Computer Engineering · dual degree</p><p data-i18n=\"education-uir-nantesIntro\" class=\"project-description\">Computer science foundations combining programming, information systems, databases and networks through the Université Internationale de Rabat–Université de Nantes partnership.</p></div><div class=\"project-context\"><div class=\"project-logos education-logos\" role=\"group\" aria-label=\"Institutions / Établissements\"><a href=\"https://www.uir.ac.ma/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"assets/logos/uir.webp\" alt=\"Université Internationale de Rabat\" class=\"school-logo school-uir\" width=\"140\" height=\"40\" loading=\"lazy\" decoding=\"async\"/></a><a href=\"https://www.univ-nantes.fr/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"assets/logos/nantes.webp\" alt=\"Nantes Université\" class=\"school-logo school-nantes\" width=\"140\" height=\"40\" loading=\"lazy\" decoding=\"async\"/></a></div><p data-i18n=\"education-uir-nantesLocation\" class=\"journey-location\">Rabat · Morocco / Nantes · France</p></div></div><div class=\"journey-highlights\" aria-label=\"Focus / Domaines\"><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m8 6-6 6 6 6M16 6l6 6-6 6M14 3l-4 18\"/></svg></span><strong data-i18n=\"education-uir-nantesFocus0\">Software development</strong></div><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"8\" ry=\"3\"/><path d=\"M4 5v14c0 4 16 4 16 0V5M4 12c0 4 16 4 16 0\"/></svg></span><strong data-i18n=\"education-uir-nantesFocus1\">Data &amp; information systems</strong></div><div><span class=\"education-focus-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"2\" width=\"6\" height=\"5\" rx=\"1\"/><rect x=\"2\" y=\"17\" width=\"6\" height=\"5\" rx=\"1\"/><rect x=\"16\" y=\"17\" width=\"6\" height=\"5\" rx=\"1\"/><path d=\"M12 7v5M5 17v-5h14v5\"/></svg></span><strong data-i18n=\"education-uir-nantesFocus2\">Systems &amp; networks</strong></div></div><details class=\"project-story education-story\" id=\"education-uir-nantes-details\"><summary><span data-i18n=\"journeyCourseDetails\">Programme &amp; subjects</span><span class=\"summary-icon\" aria-hidden=\"true\">+</span></summary><div class=\"case-content\"><h4 data-i18n=\"educationCurriculumHeading\">Curriculum overview</h4><dl class=\"education-curriculum\"><div><dt data-i18n=\"education-uir-nantesModule0Title\">Algorithms &amp; programming</dt><dd data-i18n=\"education-uir-nantesModule0Body\">Algorithms, data structures, C, object-oriented programming in C++ and Java.</dd></div><div><dt data-i18n=\"education-uir-nantesModule1Title\">Web &amp; databases</dt><dd data-i18n=\"education-uir-nantesModule1Body\">HTML, JavaScript, style sheets, relational databases and information-system modelling.</dd></div><div><dt data-i18n=\"education-uir-nantesModule2Title\">Systems &amp; networks</dt><dd data-i18n=\"education-uir-nantesModule2Body\">Computer architecture, operating systems, network fundamentals and TCP/IP.</dd></div><div><dt data-i18n=\"education-uir-nantesModule3Title\">Scientific &amp; professional foundations</dt><dd data-i18n=\"education-uir-nantesModule3Body\">Analysis, linear algebra, probability, business fundamentals, languages and communication.</dd></div></dl><p data-i18n=\"education-uir-nantesNote\" class=\"education-reference-note\">Overview based on the historical UIR licence catalogue; final-year electives vary between the Computer Science and MIAGE pathways.</p><div class=\"education-sources\"><a class=\"text-link\" href=\"https://www.uir.ac.ma/upload/media/5ca734086fda0864638061.pdf\" target=\"_blank\" rel=\"noopener noreferrer\"><span data-i18n=\"education-uir-nantesSource0\">UIR · historical licence catalogue</span><span aria-hidden=\"true\">↗</span></a><a class=\"text-link\" href=\"https://www.uir.ac.ma/upload/media/5ca71b728cc47664175614.pdf\" target=\"_blank\" rel=\"noopener noreferrer\"><span data-i18n=\"education-uir-nantesSource1\">UIR · Nantes academic partnership</span><span aria-hidden=\"true\">↗</span></a></div></div></details>",
        "label": "UIR × Université de Nantes"
      }
    ]
  },
